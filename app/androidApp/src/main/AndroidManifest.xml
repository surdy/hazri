<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Scanning, from API 31 up. `neverForLocation` is the assertion that Hazri does not use
      BLE results to derive the phone's physical location, which is what lets the scan run
      without the location permission on modern Android. It is true: what this app derives
      is which node is loudest, and it never leaves the phone.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      Below API 31 a BLE scan required the location permission and the two old Bluetooth
      permissions, whether or not the app wanted a location. minSdk is 26, so both are here,
      capped at 30 so a modern device never sees them.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- The MQTT broker. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The survey foreground service. From API 34 a service must declare a type and hold the
      permission for it: `connectedDevice` is the honest one for a BLE survey, and
      `dataSync` covers a recording taken in MQTT or simulated mode, where the app may never
      have asked for a Bluetooth permission and API 34 would refuse `connectedDevice`
      without one. SurveyForegroundService picks between them at start.

      POST_NOTIFICATIONS is asked for when the Survey tab opens. Refused, the service still
      runs and the survey still records; Android just shows nothing for it.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:name=".HazriApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hazri">
        <!--
          singleTop so the survey notification's tap target reaches the running Activity
          through onNewIntent rather than stacking a second copy of the app on top of it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".SurveyForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
